{
    "version": 2,
    "builds": [
        {
            "src": "Project/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "macLambdaSize": "15mb",
                "runtime": "python3.9"
            }
        },
        {
            "src": "build_files.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "staticfiles_build"
            }
        },
        {
            "functions": {
                "api/**.py": {
                    "maxDuration": 10,
                    "memory": 512,
                    "excludeFiles": [
                        "**/*.md",
                        "tests/**",
                        "docs/**"
                    ]
                }
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "Project/wsgi.py"
        }
    ]
}